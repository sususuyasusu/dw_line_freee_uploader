# LINE Messaging API（チャネル「領収書アップロード」@916egopi）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 本番はグループにボットが同居するため false（無言運用）
LINE_REPLY_ENABLED=false

# freee（アップローダー専用アプリ。経理自動化本体とは別アプリ）
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
# ブートストラップのみ。回転後の正本は Dropbox の state ファイル
FREEE_REFRESH_TOKEN=
FREEE_COMPANY_ID=800646

# Dropbox（証憑ボットと同じアプリを共用。Dropboxのrefresh tokenは回転しない）
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_NAMESPACE_ID=
DROPBOX_STATE_PATH=/D& W/社内/_bot-state/dw_line_freee_uploader/freee_token.json
DROPBOX_SAISON_ROOT=/D& W/社内/証憑写真/03_セゾンカード-LINE

# 管理エンドポイント（未設定なら /admin/* は 404）
ADMIN_KEY=

# 取引登録スイープ
REGISTRAR_ENABLED=true
REGISTRAR_COMMIT=true

PORT=3000
